{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://customer-service-os.example/contracts/tools/order-total/v1",
  "title": "OrderTotalV1",
  "description": "Tax-inclusive CommerceOrder.total for an owned order. Not payment, invoice, refundable balance or historical purchase total.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "reference", "total"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "reference": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,99}$" },
    "total": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amountMinor", "currency"],
      "properties": {
        "amountMinor": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "currency": { "enum": ["USD", "EUR", "GBP", "INR", "CAD", "AUD", "JPY", "KWD"] }
      }
    }
  }
}
