{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://customer-service-os.example/contracts/tools/order-items/v1",
  "title": "OrderItemsV1",
  "description": "Customer-safe current item names and quantities for a non-cancelled order owned by the verified customer. Cancelled orders are unavailable in v1; historical ordered quantities must not be substituted for current quantities.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "reference", "items"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "reference": { "type": "string", "minLength": 1, "maxLength": 100 },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "quantity"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 300, "pattern": "\\S" },
          "quantity": { "type": "integer", "minimum": 1, "maximum": 10000, "description": "Current order-line quantity, never historical orderedQuantity." }
        }
      }
    }
  }
}
