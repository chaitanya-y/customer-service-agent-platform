NODE_ENV=development
AUTH_MODE=local
HOST=127.0.0.1
PORT=3000
AGENT_RUNTIME_BASE_URL=http://127.0.0.1:8000
AGENT_RUNTIME_TIMEOUT_MILLISECONDS=60000
CONVERSATION_RUNTIME_BASE_URL=http://127.0.0.1:3004
CONVERSATION_RUNTIME_TIMEOUT_MILLISECONDS=15000
# Enable only after the Runtime handoff migration, separate staff assertions,
# Human Operations support routes, and staffed Operations Console are ready.
HUMAN_CHAT_HANDOFF_ENABLED=false
HUMAN_OPERATIONS_BASE_URL=http://127.0.0.1:3003
# Enable only after Human Operations migration 003 and private photo storage setup.
# Existing workflows keep their pinned policy version.
REFUND_POLICY_VERSION=refund-policy-v2
TENANT_ID=tenant-local
ENVIRONMENT_ID=local
HOME_REGION=local
HOME_CELL=local-cell-1
ROUTING_EPOCH=1
LOCAL_AUTH_HMAC_SECRET=<generate-a-separate-32-byte-random-secret>
LOCAL_AUTH_ISSUER=customer-service-os-local-auth
LOCAL_AUTH_AUDIENCE=customer-service-os-edge
LOCAL_CUSTOMER_ID=<vendure-customer-id>
CONTEXT_ASSERTION_HMAC_SECRET=<use-the-same-secret-as-integration-gateway>
CONTEXT_ASSERTION_ISSUER=customer-service-os-edge
CONTEXT_ASSERTION_AUDIENCE=integration-gateway
AGENT_RUNTIME_CONTEXT_ASSERTION_AUDIENCE=agent-runtime
KNOWLEDGE_RAG_CONTEXT_ASSERTION_AUDIENCE=knowledge-rag
CONVERSATION_RUNTIME_CONTEXT_ASSERTION_AUDIENCE=conversation-runtime
EDGE_SERVICE_ASSERTION_HMAC_SECRET=<generate-a-third-separate-32-byte-random-secret-for-edge-service-assertions>
EDGE_SERVICE_ASSERTION_ISSUER=customer-service-os-edge
EDGE_SERVICE_ASSERTION_AUDIENCE=conversation-runtime

# Optional local observability. No Grafana Cloud account or token needed.
CSO_TELEMETRY_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_SERVICE_NAME=edge-api
OTEL_SERVICE_VERSION=0.1.0
