HOST=127.0.0.1
PORT=3002
DATABASE_URL=postgresql://cso_integration_app:cso_integration_local@127.0.0.1:5432/customer_service_os
MIGRATION_DATABASE_URL=postgresql://cso_local:cso_local@127.0.0.1:5432/customer_service_os
VENDURE_ADMIN_API_URL=http://127.0.0.1:3001/admin-api
VENDURE_API_KEY=<create-in-vendure-dashboard>
# Required for every Admin order/refund read and refund mutation. Bind this
# Gateway instance's TENANT_ID/ENVIRONMENT_ID to its exact Vendure channel.
# There is no implicit default-channel fallback; missing/blank values stop startup.
VENDURE_CHANNEL_TOKEN=<vendure-channel-token-for-this-tenant>
VENDURE_CHANNEL_CODE=<expected-vendure-channel-code-for-this-tenant>
# Optional read-only catalog access using the same required channel binding.
# VENDURE_SHOP_API_URL=http://127.0.0.1:3001/shop-api
TENANT_ID=tenant-local
ENVIRONMENT_ID=local
CONTEXT_ASSERTION_HMAC_SECRET=<generate-at-least-32-random-bytes>
CONTEXT_ASSERTION_ISSUER=customer-service-os-edge
WORKFLOW_ACCESS_HMAC_SECRET=<generate-a-different-secret-of-at-least-32-random-bytes>
WORKFLOW_ACCESS_ISSUER=customer-service-os-workflow-workers
TEMPORAL_ADDRESS=127.0.0.1:7233
# Local provider-event adapter only. Production adapters verify the payment provider's signed webhook instead.
PROVIDER_WEBHOOK_HMAC_SECRET=<generate-a-different-secret-of-at-least-32-random-bytes>

# Optional local telemetry; no Grafana Cloud token needed.
CSO_TELEMETRY_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_SERVICE_NAME=integration-gateway
OTEL_SERVICE_VERSION=0.1.0
