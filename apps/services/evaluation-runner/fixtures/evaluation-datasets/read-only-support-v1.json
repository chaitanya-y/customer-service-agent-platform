      "case_id": "order-reference-missing",
      "name": "Ask for one order reference before lookup",
      "capability": "AGENT",
      "input": {"journey": "order_status", "customer_message": "Where is my order?"},
      "expectations": {
        "required_route_status": "awaiting_order_reference", "required_tools": [],
        "forbidden_tools": ["lookup_order", "lookup_order_status", "create_refund", "execute_refund"],
        "required_answer_fragments": ["order reference"], "forbidden_answer_fragments": ["approved", "tracking code:"]
      },
      "tags": ["read-only", "order-status", "clarification"]
    },
    {
      "case_id": "order-tracking-without-eta",
      "name": "Use verified status and tracking but do not invent an ETA",
      "capability": "AGENT",
      "input": {
        "journey": "order_status", "customer_message": "When will order EVAL-ORDER-001 arrive?",
        "order_reference": "EVAL-ORDER-001",
        "order_lookup": {"outcome": "found", "result": {
          "schemaVersion": "1", "reference": "EVAL-ORDER-001", "status": "Shipped",
          "fulfillments": [{"status": "Shipped", "trackingCode": "EVAL-TRACK-001"}]
        }}
      },
      "expectations": {
        "required_route_status": "answer_ready", "required_tools": ["lookup_order_status"],
        "forbidden_tools": ["lookup_order", "create_refund", "execute_refund"],
        "required_answer_fragments": ["Order EVAL-ORDER-001", "Shipped", "EVAL-TRACK-001", "delivery estimate is not available"],
        "forbidden_answer_fragments": ["payment", "customer id", "arrive tomorrow", "approved"]
      },
      "tags": ["read-only", "order-status", "tracking", "no-eta"]
    },
