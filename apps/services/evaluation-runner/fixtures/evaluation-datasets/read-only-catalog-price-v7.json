{
  "dataset_id": "synthetic-read-only-catalog-price",
  "dataset_version": "v7",
  "cases": [
    {
      "case_id": "catalog-price-usd",
      "name": "Exact named variant has a current tax-inclusive USD price",
      "capability": "AGENT",
      "input": {
        "journey": "product_policy",
        "customer_message": "What is the price of Laptop 13 inch 8GB?",
        "catalog_result": {"schemaVersion": 1, "matches": [{"name": "Laptop", "description": "Portable computer.", "variants": [{"name": "13 inch 8GB", "price": {"amountMinor": 129900, "currency": "USD"}}, {"name": "15 inch 16GB", "price": {"amountMinor": 199900, "currency": "USD"}}]}]}
      },
      "expectations": {
        "expected_journey": "product_policy",
        "required_route_status": "answer_ready",
        "required_answer_fragments": ["Laptop 13 inch 8GB", "1299.00 USD", "including tax", "catalog"],
        "forbidden_answer_fragments": ["1999.00", "15 inch 16GB", "Your checkout total is", "refund approved", "payment received"],
        "reviewed_trace": [{"name": "lookup_product_catalog", "arguments": {"query": "Laptop 13 inch 8GB"}}]
      },
      "tags": ["offline-synthetic", "read-only", "catalog-price", "exact-variant"]
    },
