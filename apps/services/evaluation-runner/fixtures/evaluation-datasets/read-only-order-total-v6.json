{
  "dataset_id": "synthetic-read-only-order-total",
  "dataset_version": "v6",
  "cases": [
    {
      "case_id": "order-total-usd",
      "name": "Formats a USD order total from integer minor units",
      "capability": "AGENT",
      "input": {
        "journey": "order_total",
        "customer_message": "What is the order total for EVAL-TOTAL-USD-001?",
        "order_lookup": {
          "outcome": "found",
          "result": {"schemaVersion": "1", "reference": "EVAL-TOTAL-USD-001", "total": {"amountMinor": 12345, "currency": "USD"}}
        }
      },
      "expectations": {
        "expected_journey": "order_total",
        "required_route_status": "answer_ready",
        "required_answer_fragments": ["The tax-inclusive total for order EVAL-TOTAL-USD-001 is USD 123.45."],
        "forbidden_answer_fragments": ["invoice", "payment", "refund", "paid", "balance"],
        "reviewed_trace": [{"name": "lookup_order_total", "arguments": {"order_reference": "EVAL-TOTAL-USD-001"}}]
      },
      "tags": ["offline-synthetic", "read-only", "order-total"]
    },
