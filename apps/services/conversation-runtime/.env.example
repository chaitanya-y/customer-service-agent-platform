HOST=127.0.0.1
PORT=3004
DATABASE_URL=postgresql://cso_conversation_app:cso_conversation_local@127.0.0.1:5432/customer_service_os
TENANT_ID=tenant-local
ENVIRONMENT_ID=local
CONTEXT_ASSERTION_HMAC_SECRET=<generate-at-least-32-random-bytes>
CONTEXT_ASSERTION_ISSUER=customer-service-os-edge
CONTEXT_ASSERTION_AUDIENCE=conversation-runtime
EDGE_SERVICE_ASSERTION_HMAC_SECRET=<generate-a-separate-32-byte-random-secret>
EDGE_SERVICE_ASSERTION_ISSUER=customer-service-os-edge
EDGE_SERVICE_ASSERTION_AUDIENCE=conversation-runtime
# Same new dedicated key in Human Operations; never reuse customer, Edge, staff-login, or workflow keys.
CONVERSATION_STAFF_ASSERTION_HMAC_SECRET=<generate-an-independent-32-byte-random-secret>
MESSAGE_ENCRYPTION_KEY_BASE64=<generate-exactly-32-random-bytes-as-base64>
MESSAGE_ENCRYPTION_KEY_VERSION=local-v1
