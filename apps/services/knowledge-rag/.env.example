OPENAI_API_KEY=<paste-your-key-here>
TENANT_ID=tenant-local
ENVIRONMENT_ID=local
CONTEXT_ASSERTION_HMAC_SECRET=<use-the-same-local-secret-as-edge-api>
CONTEXT_ASSERTION_ISSUER=customer-service-os-edge
KNOWLEDGE_RAG_CONTEXT_ASSERTION_AUDIENCE=knowledge-rag
KNOWLEDGE_RELEASE_ID=refund-policy-2026-08-01
KNOWLEDGE_INDEX_NAME=cso-knowledge-tenant-local-local-v1

# Without an endpoint, localhost:9200 plaintext is allowed ONLY when
# ENVIRONMENT_ID is local/development (unset retains the historical local default).
# Process environment overrides .env. Remote endpoints require verified HTTPS
# and BOTH credentials, supplied privately; never embed credentials in the URL.
# OPENSEARCH_ENDPOINT=https://search.example.com:443
# OPENSEARCH_USERNAME=<restricted-opensearch-user>
# OPENSEARCH_PASSWORD=<supply-privately>
# Optional PEM CA bundle; omitted uses the client's trusted CA bundle.
# OPENSEARCH_CA_CERTS=/absolute/path/to/ca-bundle.pem
# AWS IAM/SigV4 and Serverless are not supported by this client factory yet.
# An AWS service domain must allow HTTPS basic auth with fine-grained access
# controls; IAM-only domain policies require a future SigV4 implementation.

# Optional local telemetry; load before importing the app. No cloud token needed.
CSO_TELEMETRY_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_SERVICE_NAME=knowledge-rag
OTEL_SERVICE_VERSION=0.1.0
