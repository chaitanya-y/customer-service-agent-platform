HOST=127.0.0.1
PORT=3003
TEMPORAL_ADDRESS=127.0.0.1:7233
DATABASE_URL=postgresql://cso_human_operations_app:cso_human_operations_local@127.0.0.1:5432/customer_service_os
MIGRATION_DATABASE_URL=postgresql://cso_local:cso_local@127.0.0.1:5432/customer_service_os
TENANT_ID=tenant-local
ENVIRONMENT_ID=local
HUMAN_ACCESS_HMAC_SECRET=replace-with-a-unique-secret-of-at-least-32-bytes
HUMAN_ACCESS_ISSUER=customer-service-os-human-operations
HUMAN_OPERATIONS_WORKFLOW_HMAC_SECRET=replace-with-a-different-workflow-secret-of-at-least-32-bytes
HUMAN_OPERATIONS_WORKFLOW_ISSUER=customer-service-os-workflow-workers
# Required for Edge delivery-report assertions, and reused for optional photo evidence.
# Copy the existing Edge CONTEXT_ASSERTION_HMAC_SECRET; do not generate a different value.
CONTEXT_ASSERTION_HMAC_SECRET=copy-the-existing-edge-context-assertion-secret
CONTEXT_ASSERTION_ISSUER=customer-service-os-edge
LOCAL_HUMAN_STAFF_ID=local-refund-supervisor
LOCAL_HUMAN_ROLE=REFUND_SUPERVISOR
# Development-only local login assertion lifetime. Maximum: 30 days.
LOCAL_HUMAN_ACCESS_TTL_SECONDS=2592000
# Separate SUPPORT_AGENT login. It grants no refund or delivery permission.
LOCAL_SUPPORT_STAFF_ID=local-support-agent
LOCAL_SUPPORT_STAFF_TTL_SECONDS=2592000
# Support chat is disabled unless this distinct signing secret is configured.
# Must match Conversation Runtime; never reuse login/customer/worker secrets.
# CONVERSATION_STAFF_ASSERTION_HMAC_SECRET=replace-with-a-distinct-support-service-secret
# CONVERSATION_RUNTIME_BASE_URL=http://127.0.0.1:3004
# CONVERSATION_ROUTING_EPOCH=1
# Optional photo evidence. Leave the storage directory unset to disable it;
# the context assertion secret above remains required for delivery reporting.
# To enable photos, use an absolute private 0700 directory OUTSIDE the repository.
# REFUND_EVIDENCE_STORAGE_DIR=/absolute/private/path/refund-evidence
# Automatic file deletion is disabled pending explicit retention authorization.
# Stale PROCESSING reservations recover to REJECTED after 10 minutes without deleting files.
