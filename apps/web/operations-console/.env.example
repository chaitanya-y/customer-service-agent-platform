# Development-only assertion generated by apps/services/human-operations: pnpm local:token
CSO_LOCAL_HUMAN_TOKEN=<development-only-human-assertion>

# Separate delivery staff assertion, with cso-delivery-staff+jwt and DELIVERY_AGENT or DELIVERY_SUPERVISOR role.
CSO_LOCAL_DELIVERY_STAFF_TOKEN=<development-only-delivery-staff-assertion>
# Separate SUPPORT_AGENT assertion: pnpm local:support-token in Human Operations.
# The browser receives only a distinct support-session cookie, never this token.
CSO_LOCAL_SUPPORT_STAFF_TOKEN=<development-only-support-staff-assertion>

# Optional. The default is http://127.0.0.1:3003.
HUMAN_OPERATIONS_BASE_URL=http://127.0.0.1:3003
